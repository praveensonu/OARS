{
    "data": {
        "train_data_path": "./data/raslik/olmo_muse_remaining.jsonl"
    },
    "influence": {
        "outdir": "./data_outputs/olmo/rem/muse/",
        "seed": 42,
        "cal_words_infl": false,
        "save_to_grads_path": true,
        "n_threads": 1,
        "RapidGrad": {
            "enable": true,
            "RapidGrad_K": 65536,
            "shuffle_lambda": 20
        },
        "offload_train_grad": false,
        "skip_test": true,
        "skip_influence": true,
        "grads_path": "./gradients/muse_olmo/"
    },
    "model": {
        "model_path": "allenai/OLMo-2-0425-1B-Instruct",
        "max_length": 512,
        "load_in_4bit": false,
        "lora_path": "./outputs/olmo_muse"

    },
    "postprocess": {
        "enable": false
    }
}